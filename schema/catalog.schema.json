{
  "$schema": "https://json-schema.org/draft-07/schema",
  "$id": "https://github.com/gbi-core/agent-resource-catalog/schema/catalog.schema.json",
  "title": "Agent Resource Catalog Index",
  "description": "JSON Schema for the root catalog.json index file generated by build-catalog.py.",
  "type": "object",
  "required": ["version", "generated_at", "repo_url", "plugins", "standalone"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version for the catalog format."
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 timestamp of when this catalog was last generated.",
      "format": "date-time"
    },
    "repo_url": {
      "type": "string",
      "description": "Canonical URL of the GitHub repository hosting this catalog.",
      "format": "uri"
    },
    "plugins": {
      "type": "array",
      "description": "Indexed entries for every plugin in the plugins/ directory.",
      "items": {
        "$ref": "#/definitions/pluginEntry"
      }
    },
    "standalone": {
      "type": "array",
      "description": "Indexed entries for every resource in the standalone/ directory.",
      "items": {
        "$ref": "#/definitions/standaloneEntry"
      }
    }
  },
  "definitions": {
    "pluginEntry": {
      "type": "object",
      "required": [
        "name",
        "path",
        "version",
        "description",
        "skills",
        "commands",
        "connectors",
        "raw_url_prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Plugin identifier (kebab-case)."
        },
        "path": {
          "type": "string",
          "description": "Relative path from the repo root to the plugin directory."
        },
        "version": {
          "type": "string",
          "description": "Plugin version from plugin.json."
        },
        "description": {
          "type": "string",
          "description": "Plugin description from plugin.json."
        },
        "skills": {
          "type": "array",
          "description": "List of skill names provided by this plugin.",
          "items": {
            "type": "string"
          }
        },
        "commands": {
          "type": "array",
          "description": "List of slash-command names provided by this plugin.",
          "items": {
            "type": "string"
          }
        },
        "connectors": {
          "type": "array",
          "description": "List of MCP connector IDs wired in .mcp.json.",
          "items": {
            "type": "string"
          }
        },
        "raw_url_prefix": {
          "type": "string",
          "description": "Raw GitHub URL prefix for fetching plugin files directly.",
          "format": "uri"
        }
      }
    },
    "standaloneEntry": {
      "type": "object",
      "required": [
        "name",
        "type",
        "path",
        "version",
        "description",
        "tags",
        "entry_point",
        "raw_url_prefix"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "Resource identifier (kebab-case)."
        },
        "type": {
          "type": "string",
          "description": "Resource type: tool, template, or config.",
          "enum": ["tool", "template", "config"]
        },
        "path": {
          "type": "string",
          "description": "Relative path from the repo root to the standalone resource directory."
        },
        "version": {
          "type": "string",
          "description": "Resource version from manifest.json."
        },
        "description": {
          "type": "string",
          "description": "Resource description from manifest.json."
        },
        "tags": {
          "type": "array",
          "description": "Tags from manifest.json for filtering.",
          "items": {
            "type": "string"
          }
        },
        "entry_point": {
          "type": "string",
          "description": "Entry point filename from manifest.json."
        },
        "raw_url_prefix": {
          "type": "string",
          "description": "Raw GitHub URL prefix for fetching resource files directly.",
          "format": "uri"
        }
      }
    }
  }
}
